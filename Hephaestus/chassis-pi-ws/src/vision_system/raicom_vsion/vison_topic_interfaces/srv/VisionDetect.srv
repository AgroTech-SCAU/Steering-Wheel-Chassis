# --- 请求 ---
bool start          # true = 开始识别

---
# --- 响应 ---
int32 count                         # 检测到的目标数量
int32[] cls_ids                     # 类别 ID 列表
float64[] u_px                      # 检测框底部中心 u (像素)
float64[] v_px                      # 检测框底部中心 v (像素)
string[] cls_names                  # 类别名称列表
string message                      # 状态消息 (success / error info)
bool success                        # 是否成功执行检测
