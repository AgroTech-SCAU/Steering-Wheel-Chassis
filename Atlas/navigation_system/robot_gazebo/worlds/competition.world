<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="competition">

    <!-- Ground plane and sun -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Scene configuration -->
    <scene>
      <shadows>false</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <gui fullscreen="0">
      <camera name="orbit_camera">
        <!-- Top-down view of the arena. Robot spawns near (1.0, 0.3). -->
        <pose>2 2 5 0 1.57 0.785</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Physics: ODE -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
      <max_step_size>0.001</max_step_size>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ============================================ -->
    <!-- 15 No-Go Zone Walls (ambient 0.7 0.7 0.7 1) -->
    <!-- ============================================ -->

    <!-- 1. 垛码区货架B -->
    <model name="wall_垛码区货架B">
      <static>true</static>
      <pose>1.42 0.32 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box><size>0.76 0.32 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.76 0.32 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

