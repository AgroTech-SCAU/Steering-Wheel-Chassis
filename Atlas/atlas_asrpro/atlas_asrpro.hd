#include "asr.h"
extern "C"{ void * __dso_handle = 0 ;}
#include "setup.h"
#include "HardwareSerial.h"
#include "myLib/asr_event.h"
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

// Atlas ASRPro TWEN51 固件
//
// 定位：ASRPro 是非关键语音播报外设，只接收 MCU 单向指令并执行。
// 不负责底盘控制、任务控制、语音启动、在线检测或状态反馈。
//
// 串口协议（115200，按行解析，无 ACK、无心跳、无握手、无返回）：
//   SPK,1\n  遥操作区任务已完成
//   SPK,2\n  请说阿特拉斯启动
//   SPK,3\n  开始执行全自主运输任务
//   SPK,4\n  货物派送完成
//   SPK,5\n  全自主运输任务结束
//   SPK,6\n  当前阶段已跳过
//
// 非法命令、非法参数和溢出数据直接忽略，不影响其他设备运行。

#define ATLAS_RX_LINE_MAX 32
#define ATLAS_SPEECH_QUEUE_SIZE 4

#define ATLAS_PLAY_TRANSITION_COMPLETE 10500
#define ATLAS_PLAY_VOICE_PROMPT 10501
#define ATLAS_PLAY_AUTONOMOUS_START 10502
#define ATLAS_PLAY_DELIVERY_COMPLETE 10503
#define ATLAS_PLAY_TASK_COMPLETE 10504
#define ATLAS_PLAY_TASK_SKIPPED 10505

uint32_t snid;

// 固定语音资源；MCU 只需要发送数字 phrase_id。
//{speak:小蝶-清新女声,vol:14,speed:10,platform:haohaodada}
//{playid:10500,voice:遥操作区任务已完成}
//{playid:10501,voice:请说阿特拉斯启动}
//{playid:10502,voice:开始执行全自主运输任务}
//{playid:10503,voice:货物派送完成}
//{playid:10504,voice:全自主运输任务结束}
//{playid:10505,voice:当前阶段已跳过}

typedef struct {
  uint32_t play_id;
} AtlasSpeechRequest;

static QueueHandle_t g_speech_queue = NULL;
static char g_rx_line[ATLAS_RX_LINE_MAX] = {0};
static uint8_t g_rx_length = 0;

static void atlas_serial_task(void *parameter);
static void atlas_speech_task(void *parameter);
static void atlas_handle_line(char *line);
static void atlas_enqueue_speech(uint32_t play_id);
static uint32_t atlas_phrase_to_play_id(uint16_t phrase_id);
static bool atlas_parse_phrase_id(const char *text, uint16_t *phrase_id);

static uint32_t atlas_phrase_to_play_id(uint16_t phrase_id)
{
  switch(phrase_id){
    case 1:
      return ATLAS_PLAY_TRANSITION_COMPLETE;
    case 2:
      return ATLAS_PLAY_VOICE_PROMPT;
    case 3:
      return ATLAS_PLAY_AUTONOMOUS_START;
    case 4:
      return ATLAS_PLAY_DELIVERY_COMPLETE;
    case 5:
      return ATLAS_PLAY_TASK_COMPLETE;
    case 6:
      return ATLAS_PLAY_TASK_SKIPPED;
    default:
      return 0;
  }
}

static bool atlas_parse_phrase_id(const char *text, uint16_t *phrase_id)
{
  if(text == NULL || phrase_id == NULL || *text == '\0'){
    return false;
  }

  char *end_pointer = NULL;
  unsigned long value = strtoul(text, &end_pointer, 10);
  if(end_pointer == text || *end_pointer != '\0' || value > 65535UL){
    return false;
  }

  *phrase_id = (uint16_t)value;
  return true;
}

static void atlas_enqueue_speech(uint32_t play_id)
{
  if(g_speech_queue == NULL || play_id == 0){
    return;
  }

  AtlasSpeechRequest request;
  request.play_id = play_id;

  // 队列满时丢弃最旧的一条，优先保留较新的播报请求。
  if(xQueueSend(g_speech_queue, &request, 0) != pdTRUE){
    AtlasSpeechRequest dropped_request;
    xQueueReceive(g_speech_queue, &dropped_request, 0);
    xQueueSend(g_speech_queue, &request, 0);
  }
}

static void atlas_handle_line(char *line)
{
  if(line == NULL){
    return;
  }

  // 当前只支持：SPK,<phrase_id>
  if(strncmp(line, "SPK,", 4) != 0){
    return;
  }

  uint16_t phrase_id = 0;
  if(!atlas_parse_phrase_id(line + 4, &phrase_id)){
    return;
  }

  uint32_t play_id = atlas_phrase_to_play_id(phrase_id);
  if(play_id == 0){
    return;
  }

  atlas_enqueue_speech(play_id);
}

static void atlas_serial_task(void *parameter)
{
  (void)parameter;

  while(1){
    while(Serial.available() > 0){
      int input_value = Serial.read();
      if(input_value < 0){
        break;
      }

      char input_character = (char)input_value;

      if(input_character == '\n'){
        while(g_rx_length > 0 && g_rx_line[g_rx_length - 1] == '\r'){
          g_rx_length--;
        }

        g_rx_line[g_rx_length] = '\0';
        if(g_rx_length > 0){
          atlas_handle_line(g_rx_line);
        }

        g_rx_length = 0;
        g_rx_line[0] = '\0';
      }
      else if(input_character != '\r'){
        if(g_rx_length < ATLAS_RX_LINE_MAX - 1){
          g_rx_line[g_rx_length++] = input_character;
        }
        else{
          // 当前行过长时直接丢弃，等待下一行。
          g_rx_length = 0;
          g_rx_line[0] = '\0';
        }
      }
    }

    delay(2);
  }

  vTaskDelete(NULL);
}

static void atlas_speech_task(void *parameter)
{
  (void)parameter;

  while(1){
    AtlasSpeechRequest request;
    if(g_speech_queue != NULL && xQueueReceive(g_speech_queue, &request, 20) == pdTRUE){
      while(prompt_play_by_cmd_id(request.play_id, -1, NULL, false)){
        delay(1);
      }
    }

    delay(2);
  }

  vTaskDelete(NULL);
}

void ASR_CODE()
{
  // 本版本不使用离线识别结果，不向 MCU 或树莓派发送任何事件。
  // 保留空回调以满足 ASRPro 工程生成要求。
  (void)snid;
}

void setup()
{
  Serial.begin(115200);
  Serial.setTimeout(5);

  g_speech_queue = xQueueCreate(
    ATLAS_SPEECH_QUEUE_SIZE,
    sizeof(AtlasSpeechRequest)
  );

  xTaskCreate(atlas_serial_task, "atlas_serial", 768, NULL, 4, NULL);
  xTaskCreate(atlas_speech_task, "atlas_speech", 640, NULL, 3, NULL);
}


