#include "asr.h"
extern "C"{ void * __dso_handle = 0 ;}
#include "setup.h"
#include "HardwareSerial.h"
#include "myLib/asr_event.h"
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

// Atlas ASRPro TWEN51 固件
//
// MCU -> ASRPro：SPK,1 / SPK,2 / SPK,4 / SPK,5 / SPK,6
// ASRPro -> MCU：EVT,AUTO_START
// 115200 8N1，ASCII 按行解析，无握手、心跳、ACK 或自动重发

#define ATLAS_RX_LINE_MAX 32

// 必须与 ASRPro 工程中“阿特拉斯启动”命令词的识别 ID 一致
#define ATLAS_START_INTENT_SNID 1U

#define ATLAS_PLAY_TRANSITION_COMPLETE 10500U
#define ATLAS_PLAY_VOICE_PROMPT 10501U
#define ATLAS_PLAY_AUTONOMOUS_START 10502U
#define ATLAS_PLAY_DELIVERY_COMPLETE 10503U
#define ATLAS_PLAY_TASK_COMPLETE 10504U
#define ATLAS_PLAY_TASK_SKIPPED 10505U

uint32_t snid;

// “阿特拉斯启动”作为唤醒词，而不是普通命令词。
// 这样设备处于待机状态时也能直接识别，不依赖 enter_wakeup()。
// 语音模型声明统一放到 setup() 中，按 ASRPro 官方示例组织。

typedef enum {
  ATLAS_STATE_WAIT_TRANSITION = 0,
  ATLAS_STATE_PLAYING_TRANSITION,
  ATLAS_STATE_PLAYING_VOICE_PROMPT,
  ATLAS_STATE_WAIT_START_VOICE,
  ATLAS_STATE_READY
} AtlasRuntimeState;

static char g_rx_line[ATLAS_RX_LINE_MAX] = {0};
static uint8_t g_rx_length = 0;
static bool g_rx_discard_until_newline = false;
static volatile AtlasRuntimeState g_runtime_state =
  ATLAS_STATE_WAIT_TRANSITION;

// 第二句提示音完成回调正常情况下会进入 WAIT_START_VOICE。
// 同时保留 5 秒兜底，避免播放器回调异常导致状态永久卡死。
static volatile uint16_t g_voice_gate_fallback_ticks = 0U;

static void atlas_serial_task(void *parameter);
static void atlas_handle_line(char *line);
static bool atlas_parse_phrase_id(
  const char *text,
  uint16_t *phrase_id
);
static void atlas_begin_voice_gate(void);
static void atlas_on_voice_prompt_done(cmd_handle_t cmd_handle);

static bool atlas_parse_phrase_id(
  const char *text,
  uint16_t *phrase_id
)
{
  if(text == NULL || phrase_id == NULL || *text == '\0'){
    return false;
  }

  char *end_pointer = NULL;
  unsigned long value = strtoul(text, &end_pointer, 10);

  if(end_pointer == text ||
     *end_pointer != '\0' ||
     value > 65535UL){
    return false;
  }

  *phrase_id = (uint16_t)value;
  return true;
}

static void atlas_on_voice_prompt_done(cmd_handle_t cmd_handle)
{
  (void)cmd_handle;

  if(g_runtime_state != ATLAS_STATE_PLAYING_VOICE_PROMPT){
    return;
  }

  // “阿特拉斯启动”本身就是唤醒词，因此这里不再调用 enter_wakeup()。
  // 提示音结束后只打开应用层门控，随后用户直接说“阿特拉斯启动”即可。
  g_runtime_state = ATLAS_STATE_WAIT_START_VOICE;
  g_voice_gate_fallback_ticks = 0U;
  Serial.print("EVT,VOICE_READY\n");
}

static void atlas_begin_voice_gate(void)
{
  // 两句正在播报时重复 SPK,1 直接忽略，避免重复排队。
  if(g_runtime_state == ATLAS_STATE_PLAYING_TRANSITION ||
     g_runtime_state == ATLAS_STATE_PLAYING_VOICE_PROMPT){
    return;
  }

  // playid 定义的是“音频文件 ID”，应使用 prompt_play_by_voice_id，
  // 不能使用 prompt_play_by_cmd_id（后者参数是命令词 ID）。
  g_runtime_state = ATLAS_STATE_PLAYING_TRANSITION;

  // 第一句立即抢占当前播报。
  if(prompt_play_by_voice_id(
      ATLAS_PLAY_TRANSITION_COMPLETE,
      NULL,
      true) != 0U){
    g_runtime_state = ATLAS_STATE_WAIT_TRANSITION;
    return;
  }

  // 第二句立即加入播放器队列，不再依赖第一句结束回调去“启动”第二句。
  // 这样第一句播完后播放器会自然继续播放第二句。
  g_runtime_state = ATLAS_STATE_PLAYING_VOICE_PROMPT;
  g_voice_gate_fallback_ticks = 2500U;
  if(prompt_play_by_voice_id(
      ATLAS_PLAY_VOICE_PROMPT,
      atlas_on_voice_prompt_done,
      false) != 0U){
    g_voice_gate_fallback_ticks = 0U;
    g_runtime_state = ATLAS_STATE_WAIT_TRANSITION;
  }
}

static void atlas_handle_line(char *line)
{
  if(line == NULL || strncmp(line, "SPK,", 4) != 0){
    return;
  }

  uint16_t phrase_id = 0;
  if(!atlas_parse_phrase_id(line + 4, &phrase_id)){
    return;
  }

  switch(phrase_id){
    case 1:
      atlas_begin_voice_gate();
      break;

    case 2:
      if(g_runtime_state == ATLAS_STATE_READY){
        (void)prompt_play_by_voice_id(
          ATLAS_PLAY_AUTONOMOUS_START,
          NULL,
          false
        );
      }
      break;

    case 4:
      if(g_runtime_state == ATLAS_STATE_READY){
        (void)prompt_play_by_voice_id(
          ATLAS_PLAY_DELIVERY_COMPLETE,
          NULL,
          false
        );
      }
      break;

    case 5:
      if(g_runtime_state == ATLAS_STATE_READY){
        (void)prompt_play_by_voice_id(
          ATLAS_PLAY_TASK_COMPLETE,
          NULL,
          false
        );
      }
      break;

    case 6:
      if(g_runtime_state == ATLAS_STATE_READY){
        (void)prompt_play_by_voice_id(
          ATLAS_PLAY_TASK_SKIPPED,
          NULL,
          false
        );
      }
      break;

    default:
      break;
  }
}

static void atlas_serial_task(void *parameter)
{
  (void)parameter;

  while(1){
    while(Serial.available() > 0){
      int input_value = Serial.read();
      if(input_value < 0){
        break;
      }

      char input_character = (char)input_value;

      if(input_character == '\n'){
        if(!g_rx_discard_until_newline){
          while(g_rx_length > 0 &&
                g_rx_line[g_rx_length - 1] == '\r'){
            g_rx_length--;
          }

          g_rx_line[g_rx_length] = '\0';
          if(g_rx_length > 0){
            atlas_handle_line(g_rx_line);
          }
        }

        g_rx_length = 0;
        g_rx_line[0] = '\0';
        g_rx_discard_until_newline = false;
      }
      else{
        if(g_rx_discard_until_newline){
          continue;
        }

        if(g_rx_length < ATLAS_RX_LINE_MAX - 1){
          g_rx_line[g_rx_length++] = input_character;
        }
        else{
          g_rx_length = 0;
          g_rx_line[0] = '\0';
          g_rx_discard_until_newline = true;
        }
      }
    }

    // 防止某些固件版本播放器完成回调未触发而永久卡在提示音状态。
    // 串口任务每轮约 2 ms，2500 次约等于 5 秒。
    if(g_runtime_state == ATLAS_STATE_PLAYING_VOICE_PROMPT &&
       g_voice_gate_fallback_ticks > 0U){
      g_voice_gate_fallback_ticks--;
      if(g_voice_gate_fallback_ticks == 0U){
        g_runtime_state = ATLAS_STATE_WAIT_START_VOICE;
        Serial.print("EVT,VOICE_READY\n");
      }
    }

    delay(2);
  }

  vTaskDelete(NULL);
}

void ASR_CODE()
{
  // “阿特拉斯启动”现在是唤醒词，待机状态下即可被识别。
  // 只有收到过 SPK,1 并完成提示阶段后，应用层才接受这次启动请求。
  if(snid != ATLAS_START_INTENT_SNID){
    return;
  }

  if(g_runtime_state != ATLAS_STATE_WAIT_START_VOICE){
    return;
  }

  // 识别“阿特拉斯启动”后，覆盖 ASRPro 默认约 15 秒的唤醒保持时间。
  // 只延长当前工作态，不改变唤醒词、SPK 流程或现有状态机。
  set_state_enter_wakeup(86400000UL);  // 24 小时

  g_runtime_state = ATLAS_STATE_READY;
  g_voice_gate_fallback_ticks = 0U;
  Serial.print("EVT,AUTO_START\n");
}

void setup()
{
  // ASRPro 语音模型定义。修改这些内容后必须重新“生成模型”再编译烧录。
  // “阿特拉斯启动”定义为唤醒词：设备待机时也能直接识别。
  //{speak:小蝶-清新女声,vol:14,speed:10,platform:haohaodada}
  //{ID:1,keyword:"唤醒词",ASR:"阿特拉斯启动",ASRTO:""}
  //{playid:10500,voice:遥操作区任务已完成}
  //{playid:10501,voice:请说阿特拉斯启动}
  //{playid:10502,voice:开始执行全自主运输任务}
  //{playid:10503,voice:货物派送完成}
  //{playid:10504,voice:全自主运输任务结束}
  //{playid:10505,voice:当前阶段已跳过}

  Serial.begin(115200);
  Serial.setTimeout(5);
  g_runtime_state = ATLAS_STATE_WAIT_TRANSITION;

  xTaskCreate(
    atlas_serial_task,
    "atlas_serial",
    768,
    NULL,
    4,
    NULL
  );
}


