string backend
# A 或 B；进入导航前必须已由智能分拣观察判定，导航后端据此只选择对应半图
string arena
# 语义点位：origin / pickup / park_1 / park_2；origin 也必须携带已判定的 A/B
string waypoint_id
# 保留坐标字段兼容原有后端；比赛后端可由 arena + waypoint_id 自行解析
float64 x_m
float64 y_m
float64 yaw_rad
bool reset_origin
float64 timeout_s
---
bool success
string message
